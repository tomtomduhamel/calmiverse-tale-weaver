      "name": "Instagram — Créer Conteneur Story",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1620, 200]
    },
    {
      "parameters": {
        "amount": 20,
        "unit": "seconds"
      },
