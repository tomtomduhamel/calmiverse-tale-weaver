    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-is-19h-reel",
              "leftValue": "={{ $('Déterminer le Créneau & Paramètres').item.json.publicationType }}",
              "rightValue": "story_and_reel",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-publish-reel",
      "name": "Publier aussi en Reel (19h) ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2340, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.INSTAGRAM_USER_ID }}/media",
        "authentication": "none",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "media_type",
              "value": "REELS"
            },
            {
              "name": "video_url",
              "value": "={{ $('Générer la Vidéo 9:16 (Moteur Calmi)').item.json.publicVideoUrl }}"
            },
            {
              "name": "caption",
              "value": "=✨ {{ $('Générer Conte & Extrait par IA').item.json.title }}\n\n{{ $('Déterminer le Créneau & Paramètres').item.json.theme }}\n\n🎧 Écoutez ce conte complet avec nos voix immersives et sons d'ambiance 3D dans l'application Calmi.\n\n💬 Répondez « CALMI » en message privé pour recevoir votre accès gratuit !\n\n#calmi #sommeil #relaxation #conte #méditation #bienetre #dodo"
            },
            {
              "name": "share_to_feed",
              "value": "true"
            },
            {
              "name": "access_token",
              "value": "={{ $env.INSTAGRAM_ACCESS_TOKEN }}"
            }
          ]
        }
      },
