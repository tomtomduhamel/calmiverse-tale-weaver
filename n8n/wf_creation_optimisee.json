      ],
      "id": "854fac54-2e63-4601-adf0-5521871eb9c2",
      "name": "1. Generate & Analyze"
    },
    {
      "parameters": {
        "jsCode": "const content = $json.output?.content || '';\nconst wordCount = content.trim().split(/\\s+/).filter(Boolean).length;\n$json.wordCount = wordCount;\n$json.needsLengthening = wordCount < $json.body.targetWordCount * 0.8;\nreturn $json;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -192,
        -288
      ],
      "id": "8c3adc27-85ca-43c1-ae74-2c99ba39e017",
      "name": "2. Count Words"
    },
